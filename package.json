{
  "name": "truck-junction-web-automation",
  "version": "1.0.0",
  "description": "Cypress UI automation for trucks.tractorjunction.com",
  "scripts": {
    "cypress:open": "cypress open --browser chrome",
    "cypress:run": "cypress run --browser chrome",
    "cypress:run:chrome": "cypress run --browser chrome",
    "cypress:run:headed": "cypress run --browser chrome --headed",
    "cypress:run:tags": "cypress run --browser chrome --expose grepTags=$npm_config_tags,grepOmitFiltered=true",
    "test": "npm run cypress:run",
    "test:searchRightTruck": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/SearchRightTruck.cy.js'",
    "test:searchRightTruck:positive": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/SearchRightTruck.cy.js' --expose grepTags=@positive,grepOmitFiltered=true",
    "test:searchRightTruck:negative": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/SearchRightTruck.cy.js' --expose grepTags=@negative,grepOmitFiltered=true",
    "test:searchRightTruck:edge": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/SearchRightTruck.cy.js' --expose grepTags=@edge,grepOmitFiltered=true",
    "test:truckInIndia": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/TruckInIndia.cy.js'",
    "test:truckInIndia:positive": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/TruckInIndia.cy.js' --expose grepTags=@positive,grepOmitFiltered=true",
    "test:truckInIndia:negative": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/TruckInIndia.cy.js' --expose grepTags=@negative,grepOmitFiltered=true",
    "test:truckInIndia:edge": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/TruckInIndia.cy.js' --expose grepTags=@edge,grepOmitFiltered=true",
    "test:truckInIndia:smoke": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/TruckInIndia.cy.js' --expose grepTags=@smoke,grepOmitFiltered=true",
    "test:popularTruckBrands": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/PopularTruckBrands.cy.js'",
    "test:popularTruckBrands:smoke": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/PopularTruckBrands.cy.js' --expose grepTags=@smoke,grepOmitFiltered=true",
    "test:electricCommercialVehicles": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/ElectricCommercialVehicles.cy.js'",
    "test:electricCommercialVehicles:smoke": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/ElectricCommercialVehicles.cy.js' --expose grepTags=@smoke,grepOmitFiltered=true",
    "test:latestModelsByCategory": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/LatestModelsByCategory.cy.js'",
    "test:latestModelsByCategory:smoke": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/LatestModelsByCategory.cy.js' --expose grepTags=@smoke,grepOmitFiltered=true",
    "test:popularSecondHandTruck": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/PopularSecondHandTruck.cy.js'",
    "test:popularTruckComparison": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/PopularTruckComparison.cy.js'",
    "test:theBuzzBoard": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/TheBuzzBoard.cy.js'",
    "test:latestTruckUpdates": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/LatestTruckUpdates.cy.js'",
    "test:findReliableUsedTrucks": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/FindReliableUsedTrucksNearYou.cy.js'",
    "test:homePageSeoContent": "npm run cypress:run -- --spec 'cypress/e2e/seo/Homepage/HomePageSeoContent.cy.js'",
    "test:newTruckPdp": "npm run cypress:run -- --spec 'cypress/e2e/ui/PDP/NewTruckPdp.cy.js'",
    "test:newTruckPdp:smoke": "npm run cypress:run -- --spec 'cypress/e2e/ui/PDP/NewTruckPdp.cy.js' --expose grepTags=@smoke,grepOmitFiltered=true",
    "test:seo": "npm run cypress:run -- --spec 'cypress/e2e/seo/**/*.cy.js'",
    "test:en": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/**/*.cy.js' --expose grepTags=@en,grepOmitFiltered=true",
    "test:hi": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/**/*.cy.js' --expose grepTags=@hi,grepOmitFiltered=true",
    "test:ta": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/**/*.cy.js' --expose grepTags=@ta,grepOmitFiltered=true",
    "test:language": "npm run cypress:run -- --spec 'cypress/e2e/ui/Homepage/**/*.cy.js' --expose grepTags=@language,grepOmitFiltered=true",
    "capture:dom": "node scripts/capture-dom.js",
    "clean": "rimraf allure-results allure-report cypress/screenshots cypress/videos cypress/downloads artifacts",
    "clear:result": "rimraf allure-results",
    "generate:report": "node scripts/generate-allure-report.js",
    "open:report": "allure open allure-report",
    "allure:clean": "npm run clear:result && rimraf allure-report",
    "allure:generate": "npm run generate:report",
    "allure:open": "npm run open:report",
    "allure:report": "npm run generate:report && npm run open:report",
    "cypress:verify": "cypress verify",
    "cypress:cache:clear": "cypress cache clear",
    "lint": "eslint cypress/ pages/ config/ constants/ helpers/ --ext .js",
    "lint:fix": "eslint cypress/ pages/ config/ constants/ helpers/ --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\"",
    "docker:build": "docker build -t truck-junction-web-automation .",
    "docker:run": "docker run --rm truck-junction-web-automation"
  },
  "keywords": [
    "cypress",
    "automation",
    "testing",
    "ui-automation",
    "e2e",
    "truck-junction"
  ],
  "license": "MIT",
  "dependencies": {
    "@cypress/grep": "^6.0.3",
    "cypress": "^15.20.1"
  },
  "devDependencies": {
    "allure-commandline": "^2.34.1",
    "allure-cypress": "^3.4.2",
    "dotenv": "^17.2.3",
    "eslint": "^10.8.1",
    "eslint-plugin-cypress": "^7.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
