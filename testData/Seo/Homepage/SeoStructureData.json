        "ta": {
          "path": "/ta",
          "headings": [
            {
              "tag": "h1",
              "text": "சரியான டிரக்கை தேடு"
            },
            {
              "tag": "h2",
              "text": "ஆண்டில் உள்ள டிரக்"
            },
            {
              "tag": "h2",
              "text": "பிரபலமான டிரக் பிராண்டுகள்"
            },
            {
              "tag": "h2",
              "text": "மின்சார வணிக வாகனங்கள்"
            },
            {
              "tag": "h2",
              "text": "பிரபலமான இரண்டாம் கை டிரக்குகள்"
            },
            {
              "tag": "h2",
              "text": "வகைபடுத்தப்பட்ட புதிய மாடல்கள்"
            },
            {
              "tag": "h2",
              "text": "சமீபத்திய டிரக் புதுப்பிப்புகள்"
            },
            {
              "tag": "h2",
              "text": "உங்களுக்கு அருகிலுள்ள நம்பகமான பயன்படுத்திய டிரக்குகளைக் கண்டறியவும்"
            },
            {
              "tag": "h2",
              "text": "பிரபலமான டிரக் ஒப்பீடு"
            },
            {
              "tag": "h3",
              "text": "டிரக் ஜங்க்ஷன் பற்றி - இந்தியாவின் மிக வேகமாக வளர்ந்து வரும் ஆன்லைன் தளம் டிரக்குகளுக்காக"
            },
            {
              "tag": "h3",
              "text": "ஆம் ஆண்டில் இந்தியாவில் சிறந்த டிரக்குகளைப் பெறுங்கள்"
            },
            {
              "tag": "h3",
              "text": "இந்தியாவில் சிறந்த டிரக்குகளின் பிராண்டுகளைக் கண்டறியவும்"
            },
            {
              "tag": "h3",
              "text": "நீங்கள் வணிக வாகனங்களைத் தேடுகிறீர்களா?"
            },
            {
              "tag": "h3",
              "text": "சான்றளிக்கப்பட்ட டிரக் உதிரி பாகங்கள் டீலர்களைக் கண்டறியவும்"
            },
            {
              "tag": "h3",
              "text": "பிற சேவைகள்: டிரக்குகளை ஒப்பிடுக, செய்திகள், கட்டுரைகள், மதிப்புரைகள்"
            }
          ],
