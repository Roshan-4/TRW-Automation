# Truck Junction Web Automation - local environment config
# Copy this file to cypress/.env (which is git-ignored) and fill in real values.
# cypress.config.js loads it via dotenv and exposes selected keys to tests.

# ── Target URL ──────────────────────────────────────────────────────
# Change this value to run the same tests against another environment.
CYPRESS_BASE_URL=https://trucks.tractorjunction.com

# ── Confidential data (available in tests via Cypress.env('...')) ────
# e.g. cy.get(...).type(Cypress.env('userMobile'))
TJ_USER_MOBILE=
TJ_USER_EMAIL=
TJ_USER_OTP=
TJ_AUTH_TOKEN=
